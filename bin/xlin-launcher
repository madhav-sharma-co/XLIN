#!/usr/bin/env python3
"""XLIN App drawer - every app in one grid, like the app drawer on a phone (Run Bar button, or `xlin drawer`).

Type to search, arrows + Enter or a click to open, right-click an app to pin or unpin it on the Run Bar
(Alt+P / Alt+U work too), Esc closes. Same shape and place as the Launcher. Needs gtk4-layer-shell.
"""
import glob
import os
import subprocess
import sys

# gtk4-layer-shell must be loaded before libwayland-client: preload it once, then restart ourselves
if not os.environ.get("XLIN_LAUNCHER_REEXEC"):
    libs = glob.glob("/usr/lib/libgtk4-layer-shell.so*") + glob.glob("/usr/lib64/libgtk4-layer-shell.so*")
    if libs:
        old = os.environ.get("LD_PRELOAD", "")
        os.environ["LD_PRELOAD"] = (old + ":" if old else "") + libs[0]
        os.environ["XLIN_LAUNCHER_REEXEC"] = "1"
        os.execv(sys.executable, [sys.executable] + sys.argv)

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
try:
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gtk4LayerShell as LayerShell
except (ValueError, ImportError):
    sys.exit(3)
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402
import os as _os
sys.path[:0] = ["/usr/local/lib/xlin", _os.path.join(_os.path.dirname(_os.path.realpath(__file__)), "..", "lib")]
import xlin_ui  # noqa: E402

HOME = os.path.expanduser("~")
CSS_FILE = os.path.join(HOME, ".config/xlin/tools.css")
PINS = os.path.join(HOME, ".cache/nwg-dock-pinned")
RECENT = os.path.join(HOME, ".config/xlin/state/recent")
COLUMNS = 5
CELL_W = (600 - 2 * 16 - 2) // COLUMNS
PIN_FLAG = os.path.join(HOME, ".cache/xlin/drawer-pin")     # `xlin launcher pin` leaves this for us
MSG_NORMAL = ""
MSG_PIN = "Pick an app to pin to the run bar"


def read_ids(path):
    try:
        with open(path) as f:
            return [ln.strip() for ln in f if ln.strip()]
    except OSError:
        return []


def run(cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def fuzzy(query, text):
    """Score of query as a (fuzzy) match inside text; None if it does not match. Lower is better."""
    q, t = query.lower(), text.lower()
    if t.startswith(q):
        return 0
    if q in t:
        return 1 + t.index(q) / 100
    pos = -1
    gaps = 0
    for ch in q:
        nxt = t.find(ch, pos + 1)
        if nxt < 0:
            return None
        gaps += nxt - pos - 1
        pos = nxt
    return 2 + gaps / 100


class Launcher(Gtk.Window):
    def __init__(self, app):
        super().__init__(application=app, title="XLIN Launcher")
        self.add_css_class("xlin-launcher")
        self.set_decorated(False)
        self.set_resizable(False)
        self.was_active = False
        self.pin = False
        self.menu_open = False

        LayerShell.init_for_window(self)
        LayerShell.set_namespace(self, "xlin-launcher")
        LayerShell.set_layer(self, LayerShell.Layer.OVERLAY)
        LayerShell.set_anchor(self, LayerShell.Edge.BOTTOM, True)
        LayerShell.set_exclusive_zone(self, -1)      # 78px from the screen edge, whatever bars are there
        LayerShell.set_margin(self, LayerShell.Edge.BOTTOM, 78)
        LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.EXCLUSIVE)

        self.apps = self.load_apps()
        self.order = self.default_order()
        self.shown = []
        self.sel = 0
        self.cells = []

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_size_request(568, -1)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{m}")(16)
        self.set_child(box)

        self.entry = Gtk.Entry()
        self.entry.add_css_class("launcher-search")
        self.entry.add_css_class("drawer-search")
        self.entry.set_placeholder_text("Search apps")
        self.entry.connect("changed", lambda _e: self.rebuild())
        self.entry.connect("activate", lambda _e: self.activate_selected())
        self.entry.set_hexpand(True)
        top = Gtk.Box(spacing=8)
        top.append(self.entry)
        top.append(xlin_ui.close_button(self))       # panels only get a close button
        box.append(top)

        self.msg = Gtk.Label(label=MSG_NORMAL, xalign=0)
        self.msg.add_css_class("launcher-msg")
        self.msg.set_visible(False)
        box.append(self.msg)

        self.grid = Gtk.Grid(row_homogeneous=True, column_homogeneous=True, row_spacing=6, column_spacing=6,
                             halign=Gtk.Align.START, valign=Gtk.Align.START)
        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroll.set_propagate_natural_height(True)
        self.cell_h = 0
        self.scroll.set_child(self.grid)
        box.append(self.scroll)

        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.connect("notify::is-active", self.on_active)
        self.rebuild()
        self.entry.grab_focus()

    # ---- data
    @staticmethod
    def load_apps():
        apps, seen = [], set()
        for a in Gio.AppInfo.get_all():
            if not a.should_show() or not a.get_id():
                continue
            aid = a.get_id()
            aid = aid[:-8] if aid.endswith(".desktop") else aid
            if aid in seen:
                continue
            seen.add(aid)
            apps.append((aid, a.get_display_name(), a.get_icon()))
        apps.sort(key=lambda x: x[1].lower())
        return apps

    def default_order(self):
        return list(self.apps)          # A to Z, like the app drawer on a phone

    # ---- list
    def rebuild(self):
        q = self.entry.get_text().strip()
        if not q:
            self.shown = list(self.order)
        else:
            scored = []
            for a in self.order:
                s = fuzzy(q, a[1])
                if s is not None:
                    scored.append((s, a))
            scored.sort(key=lambda p: p[0])
            self.shown = [a for _s, a in scored]
        while (c := self.grid.get_first_child()) is not None:
            self.grid.remove(c)
        self.cells = []
        for i, (aid, name, icon) in enumerate(self.shown):
            cell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
            cell.set_size_request(CELL_W, -1)      # 5 fixed columns even when few apps match
            cell.add_css_class("drawer-item")
            img = Gtk.Image()
            img.set_pixel_size(52)
            img.set_halign(Gtk.Align.CENTER)
            if icon is not None:
                img.set_from_gicon(icon)
            else:
                img.set_from_icon_name("application-x-executable")
            lab = Gtk.Label(label=name)
            lab.add_css_class("drawer-name")
            lab.set_ellipsize(Pango.EllipsizeMode.END)
            lab.set_max_width_chars(12)
            lab.set_justify(Gtk.Justification.CENTER)
            cell.append(img)
            cell.append(lab)
            click = Gtk.GestureClick(button=1)
            click.connect("released", lambda _g, _n, _x, _y, idx=i: self.activate(idx))
            cell.add_controller(click)
            motion = Gtk.EventControllerMotion()
            motion.connect("enter", lambda _c, _x, _y, idx=i: self.hover(idx))
            cell.add_controller(motion)
            right = Gtk.GestureClick(button=3)
            right.connect("pressed", lambda g, _n, x, y, idx=i, c=cell: self.app_menu(g, idx, c, x, y))
            cell.add_controller(right)
            self.grid.attach(cell, i % COLUMNS, i // COLUMNS, 1, 1)
            self.cells.append(cell)
        self.sel = 0
        self.mark()
        self.fix_height()

    def hover(self, idx):
        if idx != self.sel and 0 <= idx < len(self.cells):
            self.sel = idx
            for i, c in enumerate(self.cells):
                (c.add_css_class if i == idx else c.remove_css_class)("selected")

    def fix_height(self):
        """Always four rows tall (about as tall as the Launcher), whatever the font makes one row."""
        if not self.cells:
            return
        if not self.cell_h:
            _m, nat, _b, _c = self.cells[0].measure(Gtk.Orientation.VERTICAL, -1)
            self.cell_h = max(nat, 70)
            self.scroll.set_min_content_height(4 * self.cell_h + 3 * 6)
            self.scroll.set_max_content_height(4 * self.cell_h + 3 * 6)

    def mark(self):
        for i, c in enumerate(self.cells):
            if i == self.sel:
                c.add_css_class("selected")
            else:
                c.remove_css_class("selected")
        if self.cells:
            self.sel = max(0, min(self.sel, len(self.cells) - 1))
            row = self.sel // COLUMNS
            adj = self.scroll.get_vadjustment()
            step = (self.cell_h or 92) + 6
            top, bottom = row * step, row * step + (self.cell_h or 92)
            if top < adj.get_value():
                adj.set_value(top)
            elif bottom > adj.get_value() + adj.get_page_size():
                adj.set_value(bottom - adj.get_page_size())

    # ---- actions
    def activate_selected(self):
        self.activate(self.sel)

    def activate(self, idx):
        if not 0 <= idx < len(self.shown):
            return
        aid = self.shown[idx][0]
        if self.pin:
            run(["xlin", "pin", aid])
        else:
            run(["xlin", "launch-app", aid])
        self.close()

    def app_menu(self, gesture, idx, cell, x, y):
        """Right-click an app: Open, Pin to the Run Bar or Unpin from it."""
        gesture.set_state(Gtk.EventSequenceState.CLAIMED)
        if not 0 <= idx < len(self.shown):
            return
        self.sel = idx
        self.mark()
        aid, name = self.shown[idx][0], self.shown[idx][1]
        pinned = aid in read_ids(PINS)
        pop = Gtk.Popover()
        pop.add_css_class("files-menu")
        pop.set_parent(cell)
        pop.set_has_arrow(False)
        rect = Gdk.Rectangle()
        rect.x, rect.y, rect.width, rect.height = int(x), int(y), 1, 1
        pop.set_pointing_to(rect)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.set_size_request(190, -1)
        items = [("Open", lambda: run(["xlin", "launch-app", aid])),
                 ("Unpin from the Run Bar" if pinned else "Pin to the Run Bar",
                  lambda: run(["xlin", "unpin" if pinned else "pin", aid]))]
        for label, fn in items:
            b = Gtk.Button(label=label, halign=Gtk.Align.FILL)
            b.get_child().set_xalign(0)
            b.add_css_class("files-menu-item")
            b.connect("clicked", lambda _b, f=fn: (pop.popdown(), f(), GLib.timeout_add(120, self.close_later)))
            box.append(b)
        pop.set_child(box)
        pop.connect("closed", lambda p: (setattr(self, "menu_open", False), GLib.idle_add(p.unparent)))
        self.menu_open = True
        pop.popup()

    def close_later(self):
        self.close()
        return False

    def on_key(self, _c, keyval, _code, state):
        alt = bool(state & Gdk.ModifierType.ALT_MASK)
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        if alt and keyval in (Gdk.KEY_p, Gdk.KEY_P, Gdk.KEY_u, Gdk.KEY_U) and self.shown:
            aid = self.shown[self.sel][0]
            run(["xlin", "pin" if keyval in (Gdk.KEY_p, Gdk.KEY_P) else "unpin", aid])
            self.close()
            return True
        moves = {Gdk.KEY_Right: 1, Gdk.KEY_Left: -1, Gdk.KEY_Down: COLUMNS, Gdk.KEY_Up: -COLUMNS,
                 Gdk.KEY_Tab: 1, Gdk.KEY_ISO_Left_Tab: -1}
        if keyval in moves and self.cells:
            new = self.sel + moves[keyval]
            if 0 <= new < len(self.cells):
                self.sel = new
            elif keyval == Gdk.KEY_Down and self.sel // COLUMNS < (len(self.cells) - 1) // COLUMNS:
                self.sel = len(self.cells) - 1
            self.mark()
            return True
        return False

    def show_fresh(self, pin=False):
        """Show the drawer again: fresh app list, empty search, first app selected."""
        self.pin = pin
        self.msg.set_text(MSG_PIN if pin else MSG_NORMAL)
        self.msg.set_visible(pin)
        self.apps = self.load_apps()
        self.order = self.default_order()
        self.was_active = False
        self.entry.set_text("")
        self.rebuild()
        self.present()
        self.entry.grab_focus()

    def on_active(self, *_a):
        if self.is_active():
            self.was_active = True
        elif self.was_active and not self.menu_open:     # clicked somewhere else: close, like a menu
            self.close()


class LauncherApp(Gtk.Application):
    """One copy keeps running out of sight; running xlin-launcher again shows or hides it."""

    def __init__(self):
        super().__init__(application_id="dev.xlin.Launcher", flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.win = None
        self.background = "--background" in sys.argv

    def do_startup(self):
        Gtk.Application.do_startup(self)
        try:
            with open(CSS_FILE, "rb") as f:
                data = f.read()
            prov = Gtk.CssProvider()
            prov.load_from_data(data)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        except Exception:
            pass

    def do_activate(self):
        pin = os.path.exists(PIN_FLAG)
        if pin:
            try:
                os.remove(PIN_FLAG)
            except OSError:
                pass
        if self.win is None:
            self.win = Launcher(self)
            xlin_ui.keep_warm(self, self.win)
            if self.background:
                self.background = False      # warm start: built and waiting, nothing on screen
                return
            self.win.show_fresh(pin)
        elif self.win.get_visible() and not pin:
            self.win.close()                 # the same key again closes it
        else:
            self.win.show_fresh(pin)


if __name__ == "__main__":
    sys.exit(LauncherApp().run([sys.argv[0]]))
