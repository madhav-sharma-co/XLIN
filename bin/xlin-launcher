#!/usr/bin/env python3
"""XLIN App drawer (Super+Space): every app, in the Launcher's own style, narrower and taller like a phone.

Type to search, click to open, right-click for Open / pin to the Run Bar / pin to the Launcher.
Esc or a click outside closes it. Needs gtk4-layer-shell.
"""
import glob
import os
import sys
import time

# gtk4-layer-shell must be loaded before libwayland-client: preload it once, then restart ourselves
if not os.environ.get("XLIN_LAUNCHER_REEXEC"):
    libs = glob.glob("/usr/lib/libgtk4-layer-shell.so*") + glob.glob("/usr/lib64/libgtk4-layer-shell.so*")
    if libs:
        old = os.environ.get("LD_PRELOAD", "")
        os.environ["LD_PRELOAD"] = (old + ":" if old else "") + libs[0]
        os.environ["XLIN_LAUNCHER_REEXEC"] = "1"
        os.execv(sys.executable, [sys.executable] + sys.argv)

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
try:
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gtk4LayerShell as LayerShell
except (ValueError, ImportError):
    sys.exit(3)
from gi.repository import Gdk, Gio, Gtk, Pango  # noqa: E402

sys.path[:0] = ["/usr/local/lib/xlin", os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib")]
import xlin_ui  # noqa: E402

HOME = os.path.expanduser("~")
CSS_FILE = os.path.join(HOME, ".config/xlin/tools.css")
COLS = 5
WIDTH = 480
HEIGHT = 560


class Drawer(Gtk.Window):
    def __init__(self, app):
        super().__init__(application=app, title="XLIN App drawer")
        self.add_css_class("xlin-launcher")
        self.set_decorated(False)
        self.set_resizable(False)
        self.was_active = False
        self.hidden_at = 0.0
        self.menu_open = False
        self.connect("notify::visible", lambda w, _p: (not w.get_visible()) and setattr(w, "hidden_at", time.monotonic()))
        self.sel = 0

        LayerShell.init_for_window(self)
        LayerShell.set_namespace(self, "xlin-launcher")
        LayerShell.set_layer(self, LayerShell.Layer.OVERLAY)
        LayerShell.set_anchor(self, LayerShell.Edge.BOTTOM, True)
        LayerShell.set_exclusive_zone(self, -1)
        LayerShell.set_margin(self, LayerShell.Edge.BOTTOM, 78)
        LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.EXCLUSIVE)

        self.apps = xlin_ui.load_apps()
        self.by_id = {a[0]: a for a in self.apps}

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_size_request(WIDTH - 2 * 16 - 2, -1)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{m}")(16)
        self.set_child(box)

        top = Gtk.Box(spacing=8)
        self.entry = Gtk.Entry(hexpand=True)
        self.entry.add_css_class("launcher-search")
        self.entry.set_placeholder_text("Search apps")
        self.entry.connect("changed", lambda _e: self.on_search())
        self.entry.connect("activate", lambda _e: self.activate(self.sel))
        top.append(self.entry)
        top.append(xlin_ui.close_button(self))
        box.append(top)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_size_request(-1, HEIGHT)
        scroll.set_vexpand(True)
        self.scroll = scroll
        self.grid = Gtk.Grid(row_spacing=6, column_spacing=6, halign=Gtk.Align.CENTER)
        scroll.set_child(self.grid)
        box.append(scroll)
        self.cells = []
        self.shown = []
        self.fill("")

        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.connect("notify::is-active", self.on_active)
        self.entry.grab_focus()

    # ---- the grid
    def app_cell(self, aid):
        app = self.by_id[aid]
        cell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        cell.add_css_class("launcher-item")
        cell.set_size_request((WIDTH - 2 * 16 - 2 - (COLS - 1) * 6 - 14) // COLS, -1)
        img = Gtk.Image()
        img.set_pixel_size(36)
        img.set_halign(Gtk.Align.CENTER)
        if app[2] is not None:
            img.set_from_gicon(app[2])
        else:
            img.set_from_icon_name("application-x-executable")
        lab = Gtk.Label(label=app[1])
        lab.add_css_class("launcher-name")
        lab.set_ellipsize(Pango.EllipsizeMode.END)
        lab.set_max_width_chars(9)
        cell.append(img)
        cell.append(lab)
        click = Gtk.GestureClick(button=1)
        click.connect("released", lambda _g, _n, _x, _y, a=aid: self.launch(a))
        cell.add_controller(click)
        right = Gtk.GestureClick(button=3)
        right.connect("pressed", lambda g, _n, x, y, a=aid, c=cell: self.menu(g, c, x, y, a))
        cell.add_controller(right)
        hover = Gtk.EventControllerMotion()
        hover.connect("enter", lambda _c, _x, _y, c=cell: self.hover(c))
        cell.add_controller(hover)
        return cell

    def fill(self, q):
        while (c := self.grid.get_first_child()) is not None:
            self.grid.remove(c)
        if q:
            scored = [(xlin_ui.fuzzy(q, a[1]), a[0]) for a in self.apps]
            ids = [aid for s, aid in sorted((p for p in scored if p[0] is not None), key=lambda p: p[0])]
        else:
            ids = [a[0] for a in sorted(self.apps, key=lambda a: a[1].lower())]
        self.shown, self.cells, self.sel = ids, [], 0
        for n, aid in enumerate(ids):
            cell = self.app_cell(aid)
            self.cells.append(cell)
            self.grid.attach(cell, n % COLS, n // COLS, 1, 1)
        if not ids:
            none = Gtk.Label(label="No apps found")
            none.add_css_class("launcher-msg")
            self.grid.attach(none, 0, 0, COLS, 1)
        self.scroll.get_vadjustment().set_value(0)
        self.mark()

    def on_search(self):
        self.fill(self.entry.get_text().strip())

    def mark(self):
        for i, c in enumerate(self.cells):
            (c.add_css_class if i == self.sel else c.remove_css_class)("selected")

    def hover(self, cell):
        if cell in self.cells:
            self.sel = self.cells.index(cell)
            self.mark()

    def scroll_to_sel(self):
        if not self.cells:
            return
        try:
            _ok, top = self.cells[self.sel].translate_coordinates(self.grid, 0, 0)
        except Exception:
            return
        adj = self.scroll.get_vadjustment()
        h = self.cells[self.sel].get_height() or 70
        if top < adj.get_value():
            adj.set_value(top)
        elif top + h > adj.get_value() + adj.get_page_size():
            adj.set_value(top + h - adj.get_page_size())

    def menu(self, gesture, widget, x, y, aid):
        gesture.set_state(Gtk.EventSequenceState.CLAIMED)
        xlin_ui.app_menu(widget, x, y, aid, hold=self.set_menu)

    def set_menu(self, state):
        self.menu_open = state

    # ---- actions
    def launch(self, aid):
        xlin_ui.run(["xlin", "launch-app", aid])
        self.close()

    def activate(self, idx):
        if 0 <= idx < len(self.shown):
            self.launch(self.shown[idx])

    def on_key(self, _c, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        step = {Gdk.KEY_Right: 1, Gdk.KEY_Left: -1, Gdk.KEY_Down: COLS, Gdk.KEY_Up: -COLS}.get(keyval)
        if step and self.cells:
            self.sel = max(0, min(len(self.cells) - 1, self.sel + step))
            self.mark()
            self.scroll_to_sel()
            return True
        return False

    def show_fresh(self):
        """Show the drawer again: fresh app list, empty search."""
        self.apps = xlin_ui.load_apps()
        self.by_id = {a[0]: a for a in self.apps}
        self.was_active = False
        self.entry.set_text("")
        self.fill("")
        self.present()
        self.entry.grab_focus()

    def on_active(self, *_a):
        if self.is_active():
            self.was_active = True
        elif self.was_active and not self.menu_open:
            self.close()


class DrawerApp(Gtk.Application):
    """One copy keeps running out of sight; running xlin-launcher again shows or hides it."""

    def __init__(self):
        super().__init__(application_id="dev.xlin.Launcher", flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.win = None
        self.background = "--background" in sys.argv

    def do_startup(self):
        Gtk.Application.do_startup(self)
        try:
            with open(CSS_FILE, "rb") as f:
                data = f.read()
            prov = Gtk.CssProvider()
            prov.load_from_data(data)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        except Exception:
            pass

    def do_activate(self):
        if self.win is None:
            self.win = Drawer(self)
            xlin_ui.keep_warm(self, self.win)
            if self.background:
                self.background = False      # warm start: built and waiting, nothing on screen
                return
            self.win.show_fresh()
        elif self.win.get_visible():
            self.win.close()                 # the same key again closes it
        elif time.monotonic() - self.win.hidden_at < 0.4:
            return                           # a click on the button that just closed it (focus loss): stay closed
        else:
            self.win.show_fresh()


if __name__ == "__main__":
    sys.exit(DrawerApp().run([sys.argv[0]]))
