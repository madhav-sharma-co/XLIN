#!/usr/bin/env python3
"""Xlin-soft Media - plays music and video. Open files or a folder, drop them on the window, or run
`xlin media file1 file2`. Space plays and pauses, arrows skip. Needs GTK4's GStreamer backend
(gst-plugins-good and gst-libav for most formats).
"""
import os
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

sys.path[:0] = ["/usr/local/lib/xlin", os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib")]
import xlin_ui  # noqa: E402

APP_ID = "dev.xlin.Media"
CSS_FILE = os.path.expanduser("~/.config/xlin/tools.css")
EXTS = {".mp3", ".flac", ".ogg", ".opus", ".wav", ".m4a", ".aac", ".wma", ".mp4", ".mkv", ".webm", ".avi",
        ".mov", ".m4v", ".mpg", ".mpeg"}


def media_files(paths):
    out = []
    for p in paths:
        if os.path.isdir(p):
            for root, _d, files in os.walk(p):
                out += [os.path.join(root, f) for f in sorted(files) if os.path.splitext(f)[1].lower() in EXTS]
        elif os.path.splitext(p)[1].lower() in EXTS or os.path.isfile(p):
            out.append(p)
    return out


class MediaWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Media")
        self.set_default_size(xlin_ui.scaled(900), xlin_ui.scaled(560))
        self.add_css_class("xlin-tools")
        xlin_ui.titlebar(self, "Media")
        self.playlist = []
        self.index = -1
        self.stream = None

        root = Gtk.Box(spacing=12)
        for m in ("top", "bottom", "start", "end"):
            getattr(root, f"set_margin_{m}")(14)
        self.set_child(root)

        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, hexpand=True)
        self.video = Gtk.Video(vexpand=True, hexpand=True)
        self.video.set_autoplay(True)
        left.append(self.video)
        self.now = Gtk.Label(label="Open a song or video to start", xalign=0)
        self.now.add_css_class("tool-title")
        self.now.set_ellipsize(Pango.EllipsizeMode.END)
        left.append(self.now)
        self.msg = Gtk.Label(label="", xalign=0)
        self.msg.add_css_class("tools-sub")
        left.append(self.msg)
        root.append(left)

        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        side.set_size_request(xlin_ui.scaled(250), -1)
        bar = Gtk.Box(spacing=6)
        for label, fn in (("Open files", self.pick_files), ("Open folder", self.pick_folder)):
            b = Gtk.Button(label=label, hexpand=True)
            b.connect("clicked", lambda _b, f=fn: f())
            bar.append(b)
        side.append(bar)
        self.list = Gtk.ListBox()
        self.list.add_css_class("fm-list")
        self.list.connect("row-activated", lambda _l, row: self.play(row.idx))
        sc = Gtk.ScrolledWindow(vexpand=True)
        sc.set_child(self.list)
        side.append(sc)
        nav = Gtk.Box(spacing=6, homogeneous=True)
        for glyph, tip, fn in (("⏮", "Previous", lambda: self.step(-1)), ("⏭", "Next", lambda: self.step(1)),
                               ("Clear", "Clear the list", self.clear)):
            b = Gtk.Button(label=glyph)
            b.set_tooltip_text(tip)
            b.connect("clicked", lambda _b, f=fn: f())
            nav.append(b)
        side.append(nav)
        root.append(side)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        drop = Gtk.DropTarget.new(Gdk.FileList, Gdk.DragAction.COPY)
        drop.connect("drop", lambda _t, fl, _x, _y: (self.add([f.get_path() for f in fl.get_files()], True), True)[1])
        self.add_controller(drop)

    # ---- playlist
    def add(self, paths, play_first=False):
        files = media_files(paths)
        if not files:
            self.msg.set_text("No music or video found")
            return
        start = len(self.playlist)
        for p in files:
            row = Gtk.ListBoxRow()
            lab = Gtk.Label(label=os.path.splitext(os.path.basename(p))[0], xalign=0)
            lab.set_ellipsize(Pango.EllipsizeMode.END)
            lab.set_margin_top(6)
            lab.set_margin_bottom(6)
            lab.set_margin_start(8)
            row.set_child(lab)
            row.idx = len(self.playlist)
            self.playlist.append(p)
            self.list.append(row)
        if play_first or self.index < 0:
            self.play(start)

    def clear(self):
        self.video.set_media_stream(None)
        self.stream, self.playlist, self.index = None, [], -1
        while (c := self.list.get_first_child()) is not None:
            self.list.remove(c)
        self.now.set_text("Open a song or video to start")
        self.msg.set_text("")

    def play(self, idx):
        if not 0 <= idx < len(self.playlist):
            return
        self.index = idx
        row = self.list.get_row_at_index(idx)
        if row is not None:
            self.list.select_row(row)
        path = self.playlist[idx]
        self.now.set_text(os.path.splitext(os.path.basename(path))[0])
        self.msg.set_text("")
        stream = Gtk.MediaFile.new_for_file(Gio.File.new_for_path(path))
        stream.connect("notify::ended", self.on_ended)
        stream.connect("notify::error", self.on_error)
        self.stream = stream
        self.video.set_media_stream(stream)
        stream.play()

    def step(self, d):
        if self.playlist:
            self.play((self.index + d) % len(self.playlist))

    def on_ended(self, stream, _p):
        if stream is self.stream and stream.get_ended() and self.index + 1 < len(self.playlist):
            self.play(self.index + 1)

    def on_error(self, stream, _p):
        err = stream.get_error()
        if err is not None:
            self.msg.set_text("Cannot play this file. Install the codecs: sudo pacman -S gst-plugins-good gst-libav")

    def on_key(self, _c, keyval, _code, _state):
        if keyval == Gdk.KEY_space and self.stream is not None:
            (self.stream.pause if self.stream.get_playing() else self.stream.play)()
            return True
        if keyval == Gdk.KEY_Right:
            self.step(1)
            return True
        if keyval == Gdk.KEY_Left:
            self.step(-1)
            return True
        return False

    # ---- choosers
    def pick_files(self):
        dlg = Gtk.FileDialog(title="Open music or video")

        def done(d, res):
            try:
                files = d.open_multiple_finish(res)
            except GLib.Error:
                return
            self.add([files.get_item(i).get_path() for i in range(files.get_n_items())], True)
        dlg.open_multiple(self, None, done)

    def pick_folder(self):
        dlg = Gtk.FileDialog(title="Open a folder")

        def done(d, res):
            try:
                f = d.select_folder_finish(res)
            except GLib.Error:
                return
            self.add([f.get_path()], True)
        dlg.select_folder(self, None, done)


class MediaApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.win = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        xlin_ui.live_css()      # restyle at once when the theme or font changes (warm apps too)
        try:
            with open(CSS_FILE, "rb") as f:
                data = f.read()
            prov = Gtk.CssProvider()
            prov.load_from_data(data)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        except Exception:
            pass

    def window(self):
        if self.win is None:
            self.win = MediaWindow(self)
        return self.win

    def do_activate(self):
        self.window().present()

    def do_open(self, files, _n, _hint):
        win = self.window()
        win.present()
        win.add([f.get_path() for f in files if f.get_path()], True)


if __name__ == "__main__":
    sys.exit(MediaApp().run(sys.argv))
