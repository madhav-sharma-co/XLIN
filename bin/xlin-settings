#!/usr/bin/env python3
"""XLIN Settings - sidebar + pages, in the style of KDE System Settings.

Usage: xlin-settings [wifi|bluetooth|display|sound|appearance|about]
Opens centered on screen (window rules in ~/.config/hypr/xlin.conf).
"""
import json
import os
import re
import shutil
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gio, GLib, Gtk  # noqa: E402
import os as _os
sys.path[:0] = ["/usr/local/lib/xlin", _os.path.join(_os.path.dirname(_os.path.realpath(__file__)), "..", "lib")]
import xlin_ui  # noqa: E402

APP_ID = "dev.xlin.Settings"
STATE = os.path.expanduser("~/.config/xlin/state")

PAGES = [
    ("general", "General", "preferences-system-symbolic"),
    ("connectivity", "Connectivity", "network-wireless-symbolic"),
    ("desktop", "Desktop", "preferences-desktop-wallpaper-symbolic"),
    ("bars", "Status Bar and Run Bar", "view-list-symbolic"),
    ("launcher", "Launcher and App Drawer", "view-app-grid-symbolic"),
    ("personalization", "Personalization", "preferences-desktop-theme-symbolic"),
    ("about", "About", "help-about-symbolic"),
]
# old page names still work (xlin settings wifi, xlin settings sound, ...): name -> (page, tab)
ALIASES = {"wifi": ("connectivity", "wifi"), "bluetooth": ("connectivity", "bluetooth"),
           "airplane": ("connectivity", "wifi"), "display": ("general", None), "sound": ("general", None),
           "appearance": ("personalization", None), "calendar": ("general", None)}

CSS = b"""
.xlin-side { padding: 10px 8px; }
.xlin-side row { border-radius: 8px; margin: 2px 0; padding: 6px 4px; }
.xlin-title { font-size: 22px; font-weight: 700; }
.xlin-sub { opacity: 0.65; font-size: 11px; }
.xlin-card { border-radius: 10px; padding: 4px 14px; background: alpha(currentColor, 0.06); }
.xlin-row { padding: 11px 0; }
"""


def run(cmd, timeout=15):
    """Run a command, never raise. Returns (ok, stdout)."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode == 0, p.stdout.strip()
    except Exception:
        return False, ""


def have(cmd):
    return shutil.which(cmd) is not None


def in_thread(fn, done=None):
    """Run fn() in a thread; call done(result) on the GTK thread."""
    def work():
        result = fn()
        if done:
            GLib.idle_add(done, result)
    threading.Thread(target=work, daemon=True).start()


def read_state(name, default=""):
    try:
        with open(os.path.join(STATE, name)) as f:
            return f.read().strip() or default
    except OSError:
        return default


# ---------------------------------------------------------------- widgets
def page_box(title, subtitle=""):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    box.set_margin_top(26)
    box.set_margin_bottom(20)
    box.set_margin_start(30)
    box.set_margin_end(30)
    t = Gtk.Label(label=title, xalign=0)
    t.add_css_class("xlin-title")
    box.append(t)
    if subtitle:
        s = Gtk.Label(label=subtitle, xalign=0)
        s.add_css_class("xlin-sub")
        box.append(s)
    return box


def card():
    c = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    c.add_css_class("xlin-card")
    c.set_margin_top(14)
    return c


def row(title, subtitle=None, widget=None):
    r = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
    r.add_css_class("xlin-row")
    text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    text.set_hexpand(True)
    text.set_valign(Gtk.Align.CENTER)
    a = Gtk.Label(label=title, xalign=0)
    text.append(a)
    if subtitle:
        b = Gtk.Label(label=subtitle, xalign=0)
        b.add_css_class("xlin-sub")
        text.append(b)
    r.append(text)
    if widget is not None:
        widget.set_valign(Gtk.Align.CENTER)
        r.append(widget)
    return r


def switch(active, on_change):
    sw = Gtk.Switch()
    sw.set_active(active)
    sw.connect("state-set", lambda _s, state: (on_change(state), False)[1])
    return sw


def slider(value, on_change, lo=0, hi=100):
    sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, 1)
    sc.set_value(value)
    sc.set_size_request(xlin_ui.scaled(240), -1)
    sc.set_draw_value(False)
    pending = {"id": 0}

    def changed(s):
        if pending["id"]:
            GLib.source_remove(pending["id"])

        def fire():
            pending["id"] = 0
            on_change(s.get_value())
            return False
        pending["id"] = GLib.timeout_add(180, fire)  # debounce while dragging
    sc.connect("value-changed", changed)
    return sc


def button(label, on_click):
    b = Gtk.Button(label=label)
    b.connect("clicked", lambda _b: on_click())
    return b


# ----------------------------------------------------------------- pages
class WifiPage(Gtk.Box):
    def __init__(self, win):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.win = win
        self.box = page_box("Wi-Fi", "Choose a network")
        ok, out = run(["nmcli", "radio", "wifi"])
        on = out == "enabled"
        top = card()
        top.append(row("Wi-Fi", None, switch(on, self.set_radio)))
        self.box.append(top)
        self.status = Gtk.Label(label="", xalign=0)
        self.status.add_css_class("xlin-sub")
        self.status.set_margin_top(8)
        self.box.append(self.status)
        self.list_card = card()
        self.box.append(self.list_card)
        self.box.append(Gtk.Box(vexpand=True))
        self.refresh_btn = button("Refresh", self.refresh)
        self.refresh_btn.set_halign(Gtk.Align.START)
        self.box.append(self.refresh_btn)
        if have("nmcli"):
            self.refresh()
        else:
            self.status.set_text("NetworkManager (nmcli) is not installed.")

    def set_radio(self, state):
        in_thread(lambda: run(["nmcli", "radio", "wifi", "on" if state else "off"]),
                  lambda _r: self.refresh())

    def refresh(self):
        self.status.set_text("Scanning...")
        in_thread(lambda: run(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY",
                               "dev", "wifi", "list", "--rescan", "yes"], 25), self.show)

    def show(self, result):
        ok, out = result
        child = self.list_card.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.list_card.remove(child)
            child = nxt
        seen = set()
        for line in out.splitlines():
            parts = re.split(r"(?<!\\):", line)
            if len(parts) < 4:
                continue
            use, ssid, sig, sec = parts[0], parts[1].replace("\\:", ":"), parts[2], parts[3]
            if not ssid or ssid in seen:
                continue
            seen.add(ssid)
            connected = use.strip() == "*"
            sub = f"Signal {sig}%" + (" · Secured" if sec and sec != "--" else " · Open")
            if connected:
                b = Gtk.Label(label="Connected")
            else:
                b = button("Connect", lambda s=ssid, e=(sec and sec != "--"): self.connect_to(s, e))
            self.list_card.append(row(ssid, sub, b))
        self.status.set_text("" if seen else "No networks found (is Wi-Fi turned on?)")

    def connect_to(self, ssid, secured):
        self.status.set_text(f"Connecting to {ssid}...")

        def work():
            return run(["nmcli", "dev", "wifi", "connect", ssid], 30)

        def done(res):
            ok, _ = res
            if ok:
                self.status.set_text(f"Connected to {ssid}")
                self.refresh()
            elif secured:
                self.ask_password(ssid)
            else:
                self.status.set_text(f"Could not connect to {ssid}")
        in_thread(work, done)

    def ask_password(self, ssid):
        d = Gtk.Window(title=f"Password for {ssid}", modal=True, transient_for=self.win)
        d.set_default_size(xlin_ui.scaled(340), xlin_ui.scaled(120))
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for m in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{m}")(18)
        entry = Gtk.PasswordEntry(show_peek_icon=True)
        box.append(entry)
        go = Gtk.Button(label="Connect")
        go.add_css_class("suggested-action")

        def submit(*_a):
            pw = entry.get_text()
            d.close()
            self.status.set_text(f"Connecting to {ssid}...")
            in_thread(lambda: run(["nmcli", "dev", "wifi", "connect", ssid, "password", pw], 30),
                      lambda r: (self.status.set_text(
                          f"Connected to {ssid}" if r[0] else "Wrong password or network unreachable"),
                          self.refresh()))
        go.connect("clicked", submit)
        entry.connect("activate", submit)
        box.append(go)
        d.set_child(box)
        d.present()


class BluetoothPage(Gtk.Box):
    def __init__(self, win):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.box = page_box("Bluetooth", "Your devices")
        _ok, show = run(["bluetoothctl", "show"])
        _ok2, rf = run(["rfkill", "list", "bluetooth"])
        powered = "Powered: yes" in show and "Soft blocked: yes" not in rf
        top = card()
        top.append(row("Bluetooth", None, switch(powered, self.set_radio)))
        self.box.append(top)
        self.status = Gtk.Label(label="", xalign=0, wrap=True)
        self.status.add_css_class("xlin-sub")
        self.status.set_margin_top(8)
        self.box.append(self.status)
        self.list_card = card()
        self.box.append(self.list_card)
        self.box.append(Gtk.Box(vexpand=True))
        bar = Gtk.Box(spacing=8)
        bar.append(button("Refresh", lambda: self.refresh(False)))
        bar.append(button("Scan for new devices", lambda: self.refresh(True)))
        self.box.append(bar)
        if not have("bluetoothctl"):
            self.status.set_text("bluetoothctl is not installed. Run: sudo pacman -S bluez-utils")
            return
        ok, active = run(["systemctl", "is-active", "bluetooth"])
        if active != "active":
            self.status.set_text("The Bluetooth service is not running. "
                                 "Run: sudo systemctl enable --now bluetooth")
        else:
            self.refresh(False)

    def set_radio(self, state):
        def work():
            if state:
                run(["rfkill", "unblock", "bluetooth"])
                return run(["bluetoothctl", "power", "on"])
            return run(["bluetoothctl", "power", "off"])
        in_thread(work, lambda _r: self.refresh(False))

    def refresh(self, scan=False):
        self.status.set_text("Scanning for devices (8 seconds)..." if scan else "Loading...")

        def work():
            if scan:
                run(["bluetoothctl", "--timeout", "8", "scan", "on"], 20)
            _ok, out = run(["bluetoothctl", "devices"])
            devs = []
            for line in out.splitlines():
                m = re.match(r"Device\s+(\S+)\s+(.*)", line)
                if m:
                    mac, name = m.groups()
                    if re.fullmatch(r"[0-9A-F]{2}([-:][0-9A-F]{2}){5}", name):
                        continue  # unnamed device, shown only as its address
                    _ok2, info = run(["bluetoothctl", "info", mac])
                    devs.append((mac, name, "Paired: yes" in info, "Connected: yes" in info))
            devs.sort(key=lambda d: (not d[3], not d[2], d[1].lower()))
            return devs
        in_thread(work, self.show)

    def show(self, devs):
        child = self.list_card.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.list_card.remove(child)
            child = nxt
        for mac, name, paired, connected in devs:
            if connected:
                label, sub = "Disconnect", "Connected"
            elif paired:
                label, sub = "Connect", "Paired"
            else:
                label, sub = "Pair", "Nearby"
            self.list_card.append(row(name, sub, button(
                label, lambda m=mac, p=paired, c=connected: self.act(m, p, c))))
        self.status.set_text("" if devs else "No devices yet. Put your device in pairing mode, "
                                              "then press \"Scan for new devices\".")

    def act(self, mac, paired, connected):
        self.status.set_text("Working...")

        def work():
            if connected:
                return run(["bluetoothctl", "disconnect", mac], 20)
            if not paired:
                run(["bluetoothctl", "pair", mac], 40)
                run(["bluetoothctl", "trust", mac], 10)
            return run(["bluetoothctl", "connect", mac], 25)
        in_thread(work, lambda r: (
            self.status.set_text("" if r[0] else "That did not work. Is the device in pairing mode?"),
            self.refresh(False)))


def display_rows(c):
    ok, out = run(["brightnessctl", "-m", "info"])
    pct = 70
    if ok and out:
        m = re.search(r"(\d+)%", out)
        if m:
            pct = int(m.group(1))
    if have("brightnessctl") and ok:
        c.append(row("Brightness", None,
                     slider(pct, lambda v: run(["brightnessctl", "set", f"{max(1, int(v))}%"]), 1, 100)))
    else:
        c.append(row("Brightness", "No adjustable backlight found (normal on desktop PCs)"))
    if have("nwg-displays"):
        c.append(row("Screen layout", "Resolution, position and scale",
                     button("Open...", lambda: subprocess.Popen(["nwg-displays"]))))
    else:
        c.append(row("Screen layout", "Install nwg-displays to arrange screens"))


def sound_rows(c):
    vol = 50
    ok, out = run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
    m = re.search(r"([\d.]+)", out or "")
    if m:
        vol = int(float(m.group(1)) * 100)
    c.append(row("Volume", None, slider(
        min(vol, 100),
        lambda v: run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{v / 100:.2f}"]))))
    c.append(row("Mute", None, switch(
        "MUTED" in (out or ""),
        lambda s: run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if s else "0"]))))
    if have("pavucontrol"):
        c.append(row("Devices and apps", "Choose speakers, microphone, per-app volume",
                     button("Open...", lambda: subprocess.Popen(["pavucontrol"]))))


ACCENTS = [("blue", "#5269dc"), ("teal", "#1f9d9a"), ("green", "#2f9e5f"),
           ("rose", "#c9507a"), ("orange", "#d9772b"), ("graphite", "#4a5568")]
CSS += (b".swatch { min-width: 28px; min-height: 28px; padding: 0; border-radius: 14px;"
        b" background-image: none; box-shadow: none; border: 2px solid transparent; }\n"
        b".swatch.active { border-color: currentColor; }\n"
        + "".join(f".swatch-{n} {{ background-color: {hx}; }}\n" for n, hx in ACCENTS).encode())


def accent_dots():
    """A row of colour dots; clicking one runs `xlin accent <name>`."""
    current = read_state("accent", "blue")
    box = Gtk.Box(spacing=8)
    dots = {}

    def pick(name):
        for n, b in dots.items():
            if n == name:
                b.add_css_class("active")
            else:
                b.remove_css_class("active")
        in_thread(lambda: run(["xlin", "accent", name], 30))
    for name, _hx in ACCENTS:
        b = Gtk.Button()
        b.add_css_class("swatch")
        b.add_css_class(f"swatch-{name}")
        b.set_tooltip_text(name.capitalize())
        if name == current:
            b.add_css_class("active")
        b.connect("clicked", lambda _b, n=name: pick(n))
        dots[name] = b
        box.append(b)
    return box


def font_families(mono):
    """Installed font family names (monospace ones only when mono)."""
    ok, out = run(["fc-list", ":spacing=100" if mono else ":", "family"], 10)
    names = set()
    for line in (out or "").splitlines():
        first = line.split(",")[0].strip()
        if first and not first.startswith("."):
            names.add(first)
    return sorted(names, key=str.lower)


def terminal_font():
    """(family, size) from the terminal's font file."""
    fam, size = "", "11.5"
    try:
        with open(os.path.expanduser("~/.config/kitty/xlin-font.conf")) as f:
            for ln in f:
                m = re.match(r'font_family\s+family="?([^"\n]+)"?', ln)
                if m:
                    fam = m.group(1).strip()
                m = re.match(r"font_size\s+([\d.]+)", ln)
                if m:
                    size = m.group(1)
    except OSError:
        pass
    return fam or "JetBrainsMono Nerd Font", size


def font_picker(families, current, on_pick):
    if current and current not in families:
        families = [current] + families
    dd = Gtk.DropDown.new_from_strings(families or [current or "DM Sans"])
    dd.set_enable_search(True)
    dd.set_expression(Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
    dd.set_size_request(xlin_ui.scaled(220), -1)
    if current in families:
        dd.set_selected(families.index(current))
    state = {"ready": False}
    GLib.idle_add(lambda: (state.update(ready=True), False)[1])

    def changed(_d, _p):
        item = dd.get_selected_item()
        if state["ready"] and item is not None:
            on_pick(item.get_string())
    dd.connect("notify::selected", changed)
    return dd


def appearance_page(win):
    box = page_box("Personalization", "Theme, accent colour, transparency and wallpaper")
    c = card()
    box.append(c)
    dark = read_state("theme", "light") == "dark"
    c.append(row("Dark mode", "Top bar, Run Bar, launcher, panel and apps", switch(
        dark, lambda s: in_thread(lambda: run(["xlin", "theme", "dark" if s else "light"], 30)))))

    c.append(row("Accent colour", "Highlights, buttons and selections", accent_dots()))

    def set_opacity(v):
        val = "1.0" if v >= 100 else f"{v / 100:.2f}"
        run(["xlin", "opacity", val])
    c.append(row("Window transparency", "Fullscreen windows are always solid",
                 slider(85, set_opacity, 40, 100)))
    def pick_wall():
        dlg = Gtk.FileDialog(title="Choose a wallpaper")
        flt = Gtk.FileFilter()
        flt.set_name("Images")
        flt.add_mime_type("image/png")
        flt.add_mime_type("image/jpeg")
        flt.add_mime_type("image/webp")
        store = Gio.ListStore.new(Gtk.FileFilter)
        store.append(flt)
        dlg.set_filters(store)

        def done(d, res):
            try:
                f = d.open_finish(res)
            except GLib.Error:
                return
            in_thread(lambda: run(["xlin", "wallpaper", f.get_path()], 30))
        dlg.open(win, None, done)

    wb = Gtk.Box(spacing=8)
    wb.append(button("Next", lambda: in_thread(lambda: run(["xlin", "wallpaper", "next"], 30))))
    wb.append(button("Choose image...", pick_wall))
    c.append(row("Wallpaper", None, wb))
    c.append(row("Animations", "Windows, menus and workspaces: smooth is the MacBook feel", segmented(
        [("off", "Off"), ("subtle", "Subtle"), ("smooth", "Smooth")], read_state("animations", "smooth"),
        lambda v: in_thread(lambda: run(["xlin", "animations", v], 15)))))

    cf = card()
    box.append(cf)
    head = Gtk.Label(label="Fonts and sizes", xalign=0, margin_top=10)
    head.add_css_class("xlin-sub")
    cf.append(head)
    cf.append(row("System font", "Bars, panels and apps",
                  font_picker(font_families(False), read_state("ui_font", "DM Sans"),
                              lambda name: in_thread(lambda: run(["xlin", "font", name], 40)))))
    cf.append(row("Text size", "Bars, panels and apps", segmented(
        [("small", "Small"), ("normal", "Normal"), ("large", "Large"), ("huge", "Huge")],
        read_state("ui_size", "normal"), lambda v: in_thread(lambda: run(["xlin", "font", "size", v], 40)))))
    tfont, tsize = terminal_font()
    cf.append(row("Terminal font", "Monospace fonts only",
                  font_picker(font_families(True), tfont,
                              lambda name: in_thread(lambda: run(["xlin", "terminal", "font", name, tsize], 20)))))
    cf.append(row("Terminal text size", "Applies to new terminal windows", segmented(
        [("10", "Small"), ("11.5", "Normal"), ("13", "Large"), ("15", "Huge")], tsize,
        lambda v: in_thread(lambda: run(["xlin", "terminal", "font", tfont, v], 20)))))
    cf.append(row("Back to the default look", None, button("Reset", lambda: in_thread(
        lambda: run(["xlin", "font", "reset"], 40), lambda _r: win.rebuild("personalization")))))
    return box


def segmented(options, current, on_change):
    """A row of linked toggle buttons: options = [(value, label)]; calls on_change(value)."""
    box = Gtk.Box(spacing=0)
    box.add_css_class("linked")
    first = None
    for value, label in options:
        b = Gtk.ToggleButton(label=label)
        if first is None:
            first = b
        else:
            b.set_group(first)
        b.value = value
        if str(value) == str(current):
            b.set_active(True)
        b.connect("toggled", lambda btn, v=value: btn.get_active() and on_change(v))
        box.append(b)
    return box


BAR_ITEMS = [
    ("settings", "Settings shortcut", "The gear button"),
    ("tools", "Tools shortcut", "Calculator, calendar, notes and screenshot"),
    ("wifi", "Wi-Fi", "Network status and quick switch"),
    ("bluetooth", "Bluetooth", "Bluetooth status and devices"),
    ("sound", "Sound", "Volume"),
    ("battery", "Battery", "Charge and power mode (hidden by itself on computers without a battery)"),
    ("power", "Power menu", "Lock, sleep, log out, restart, power off"),
    ("panel", "Control panel", "Notifications and quick toggles"),
]


def bars_page(win):
    box = page_box("Status Bar and Run Bar", "Choose what shows on the top bar and how the Run Bar behaves")
    hidden = set(read_state("bar_hidden", "").split())
    c = card()
    box.append(c)
    head = Gtk.Label(label="Status bar (the top bar)", xalign=0, margin_top=10)
    head.add_css_class("xlin-sub")
    c.append(head)
    for name, title, sub_ in BAR_ITEMS:
        c.append(row(title, sub_, switch(
            name not in hidden,
            lambda s, n=name: in_thread(lambda: run(["xlin", "bar", "show" if s else "hide", n])))))
    c.append(row("Show everything again", None,
                 button("Reset", lambda: in_thread(lambda: run(["xlin", "bar", "reset"]),
                                                   lambda _r: win.rebuild("bars")))))

    c2 = card()
    box.append(c2)
    head2 = Gtk.Label(label="Run Bar (the bar at the bottom)", xalign=0, margin_top=10)
    head2.add_css_class("xlin-sub")
    c2.append(head2)
    c2.append(row("Auto-hide", "Show it only when you reach the bottom edge", switch(
        read_state("dock_autohide", "on") != "off",
        lambda s: in_thread(lambda: run(["xlin", "runbar", "autohide", "on" if s else "off"])))))
    c2.append(row("Icon size", None, segmented(
        [("32", "Small"), ("40", "Medium"), ("48", "Large")], read_state("dock_icon", "40"),
        lambda v: in_thread(lambda: run(["xlin", "runbar", "size", v])))))
    return box


def dnd_on():
    ok, out = run(["swaync-client", "-D"], 3)
    return ok and out.strip() == "true"


def airplane_on():
    ok, out = run(["rfkill", "list", "all"], 3)
    return ok and "Soft blocked: no" not in out and "Soft blocked: yes" in out


def general_page(win):
    box = page_box("General", "Sound, brightness, notifications and sleep")
    c = card()
    box.append(c)
    sound_rows(c)
    display_rows(c)

    cn = card()
    box.append(cn)
    cn.append(row("Do not disturb", "Hide notification pop-ups (they still collect in the control panel)", switch(
        dnd_on(), lambda s: in_thread(lambda: run(["swaync-client", "-dn" if s else "-df"], 5)))))

    c2 = card()
    box.append(c2)
    c2.append(row("Lock when idle", "Lock the screen when you are away", switch(
        not os.path.exists(os.path.join(STATE, "idle_off")),
        lambda s: in_thread(lambda: run(["xlin", "idle", "on" if s else "off"], 20)))))
    c2.append(row("Lock after", None, segmented(
        [("2", "2 min"), ("5", "5 min"), ("10", "10 min"), ("30", "30 min")], read_state("idle_minutes", "5"),
        lambda v: in_thread(lambda: run(["xlin", "idle", "set", v], 20)))))
    c2.append(row("Night light", "Warmer screen colour in the evening", switch(
        os.path.exists(os.path.join(STATE, "nightlight")) and read_state("nightlight", "") != "",
        lambda s: in_thread(lambda: run(["xlin", "nightlight", "on" if s else "off"], 20)))))
    c2.append(row("Keep apps ready", "Settings, Files, Store and the Launcher wait out of sight so they open instantly", switch(
        not os.path.exists(os.path.join(STATE, "warm_off")),
        lambda s: in_thread(lambda: run(["xlin", "warm", "on" if s else "off"], 20)))))
    c2.append(row("Terminal", "What Super+Return opens", segmented(
        [("xlin", "XLIN Terminal"), ("kitty", "Kitty")], read_state("terminal", "xlin"),
        lambda v: in_thread(lambda: run(["xlin", "terminal", "use", v])))))
    return box


class ConnectivityPage(Gtk.Box):
    """Airplane mode, then Wi-Fi and Bluetooth as two tabs."""

    def __init__(self, win, keep):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.win = win
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        top = page_box("Connectivity", "Airplane mode, Wi-Fi and Bluetooth")
        c = card()
        c.append(row("Airplane mode", "Turns Wi-Fi and Bluetooth off together", switch(
            airplane_on(), lambda s: in_thread(lambda: run(["rfkill", "block" if s else "unblock", "all"], 10)))))
        top.append(c)
        self.stack = Gtk.Stack(vexpand=True)
        self.stack.add_named(keep(WifiPage(win)), "wifi")
        self.stack.add_named(keep(BluetoothPage(win)), "bluetooth")
        self.tabs = segmented([("wifi", "Wi-Fi"), ("bluetooth", "Bluetooth")], "wifi",
                              lambda v: self.stack.set_visible_child_name(v))
        self.tabs.set_halign(Gtk.Align.START)
        self.tabs.set_margin_top(12)
        top.append(self.tabs)
        self.box.append(top)
        self.box.append(self.stack)

    def show_tab(self, name):
        self.stack.set_visible_child_name(name)
        child = self.tabs.get_first_child()
        while child is not None:
            if getattr(child, "value", None) == name:
                child.set_active(True)
            child = child.get_next_sibling()


DESKTOP_CFG = os.path.expanduser("~/.config/xlin/desktop.json")
DESKTOP_WIDGETS = [("clock", "Clock"), ("calendar", "Calendar"), ("system", "System"), ("battery", "Battery"),
                   ("media", "Media player"), ("notes", "Notes"), ("todo", "To-do list"), ("timer", "Timer")]


def desktop_edit(change):
    """Change desktop.json, then restart the desktop layer so it picks the change up."""
    def work():
        try:
            with open(DESKTOP_CFG) as f:
                cfg = json.load(f)
        except (OSError, ValueError):
            cfg = {}
        run(["pkill", "-f", "[x]lin-desktop$"], 3)
        change(cfg)
        os.makedirs(os.path.dirname(DESKTOP_CFG), exist_ok=True)
        with open(DESKTOP_CFG, "w") as f:
            json.dump(cfg, f, indent=1)
        if not os.path.exists(os.path.join(STATE, "desktop_off")):
            run(["xlin", "desktop", "start"], 10)
    in_thread(work)


def desktop_page(win):
    box = page_box("Desktop", "Icons, widgets, wallpaper and the mouse")
    try:
        with open(DESKTOP_CFG) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        cfg = {}
    c = card()
    box.append(c)
    dstatus = Gtk.Label(label="Checking...", xalign=0)
    dstatus.add_css_class("xlin-sub")
    dstatus.set_wrap(True)

    def refresh_status():
        in_thread(lambda: run(["xlin", "desktop", "status"], 10)[1] or "unknown",
                  lambda text: dstatus.set_text(text))
    refresh_status()
    c.append(row("Status", None, dstatus))
    c.append(row("Restart the desktop layer", "Use this if right-click on the desktop does nothing", button(
        "Restart", lambda: in_thread(lambda: run(["xlin", "desktop", "restart"], 20),
                                     lambda _r: GLib.timeout_add(1500, lambda: (refresh_status(), False)[1])))))
    c.append(row("Desktop layer", "Right-click menu, icons and widgets on the desktop", switch(
        not os.path.exists(os.path.join(STATE, "desktop_off")),
        lambda s: in_thread(lambda: run(["xlin", "desktop", "on" if s else "off"], 20)))))
    c.append(row("Show desktop icons", None, switch(
        cfg.get("show_icons", True), lambda s: desktop_edit(lambda d: d.__setitem__("show_icons", s)))))
    c.append(row("Icon size", None, segmented(
        [("small", "Small"), ("medium", "Medium"), ("large", "Large")], cfg.get("icon_size", "medium"),
        lambda v: desktop_edit(lambda d: d.__setitem__("icon_size", v)))))

    cw = card()
    box.append(cw)
    head = Gtk.Label(label="Widgets", xalign=0, margin_top=10)
    head.add_css_class("xlin-sub")
    cw.append(head)
    widgets = cfg.get("widgets", {}) if isinstance(cfg.get("widgets"), dict) else {}
    for key, name in DESKTOP_WIDGETS:
        on = widgets.get(key, {}).get("on", key == "clock")

        def set_widget(state, k=key):
            def change(d):
                w = d.setdefault("widgets", {}).setdefault(k, {})
                w["on"] = state
            desktop_edit(change)
        cw.append(row(name, None, switch(on, set_widget)))

    cm = card()
    box.append(cm)
    wb = Gtk.Box(spacing=8)
    wb.append(button("Next", lambda: in_thread(lambda: run(["xlin", "wallpaper", "next"], 30))))
    cm.append(row("Wallpaper", "More choices are in Personalization", wb))
    cm.append(row("Mouse cursor size", None, segmented(
        [("24", "Small"), ("32", "Medium"), ("48", "Large"), ("64", "Huge")], read_state("cursor_size", "24"),
        lambda v: in_thread(lambda: run(["xlin", "cursor", v])))))
    return box


def launcher_page(win):
    box = page_box("Launcher and App Drawer", "Right-click an app in the Launcher to pin it to the Launcher or the Run Bar")
    c = card()
    box.append(c)
    pins = []
    try:
        with open(os.path.expanduser("~/.cache/nwg-dock-pinned")) as f:
            pins = [ln.strip() for ln in f if ln.strip()]
    except OSError:
        pass
    def section(title, ids, empty, unpin):
        h = Gtk.Label(label=title, xalign=0, margin_top=10)
        h.add_css_class("xlin-sub")
        c.append(h)
        if not ids:
            c.append(row(empty, "Right-click an app in the Launcher to pin it"))
        for pid in ids:
            app = Gio.DesktopAppInfo.new(pid + ".desktop")
            c.append(row(app.get_display_name() if app else pid, None, button("Unpin", lambda p=pid: unpin(p))))

    def unpin_bar(p):
        in_thread(lambda: run(["xlin", "unpin", p], 15), lambda _r: win.rebuild("launcher"))

    def unpin_start(p):
        xlin_ui.set_launcher_pin(p, False)
        win.rebuild("launcher")
    section("Pinned in the Launcher", xlin_ui.launcher_pins() or [], "Nothing pinned in the Launcher", unpin_start)
    section("Pinned on the Run Bar", pins, "Nothing pinned on the Run Bar", unpin_bar)
    c2 = card()
    box.append(c2)
    c2.append(row("Clear recent apps", "Empties the Recent list in the Launcher", button(
        "Clear", lambda: in_thread(lambda: (
            os.path.exists(os.path.join(STATE, "recent")) and os.remove(os.path.join(STATE, "recent")))))))
    c2.append(row("Open the Launcher", "Search, pinned, recent and all apps (tap Super)", button(
        "Open", lambda: subprocess.Popen(["xlin", "launcher"]))))
    return box


def vte_available():
    """True when XLIN Terminal can start (needs the VTE library: sudo pacman -S vte4)."""
    try:
        import gi as _gi
        _gi.require_version("Vte", "3.91")
        from gi.repository import Vte  # noqa: F401
        return True
    except (ValueError, ImportError):
        return False


def xlin_version():
    ok, out = run(["xlin", "version"])
    return out.replace("xlin", "").strip() if ok and out else "unknown"


def about_page(win):
    box = page_box("About", "XLIN desktop")
    c = card()
    box.append(c)
    c.append(row("XLIN", f"Version {xlin_version()}"))
    ok, out = run(["hyprctl", "version", "-j"])
    ver = "unknown"
    m = re.search(r'"tag"\s*:\s*"([^"]+)"', out or "")
    if m:
        ver = m.group(1)
    c.append(row("Hyprland", ver))
    c.append(row("User", f"{os.environ.get('USER', '?')}@{os.uname().nodename}"))
    c.append(row("Theme", read_state("theme", "light")))

    # ---- updates
    u = card()
    box.append(u)
    status = Gtk.Label(label="Checking for updates...", xalign=0)
    status.add_css_class("xlin-sub")
    text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    text.append(status)

    def check():
        status.set_text("Checking for updates...")

        def work():
            ok, out = run(["xlin", "update", "check"], 40)
            return out or "Could not check for updates"

        def done(msg):
            status.set_text(msg.splitlines()[-1] if msg else "")
        in_thread(work, done)

    def run_update():
        cmd = "xlin update; echo; read -rp 'Done. Press Enter to close.'"
        if have("xlin-terminal") and vte_available():
            args = ["xlin-terminal", "-e", "bash", "-c", cmd]          # XLIN's own terminal
        else:
            term = next((t for t in ("kitty", "foot", "alacritty", "gnome-terminal", "konsole", "xterm")
                         if have(t)), None)
            if term is None:
                status.set_text("Open a terminal (Super+Return) and run: xlin update")
                return
            args = [term, "--", "bash", "-c", cmd] if term == "gnome-terminal" else [term, "-e", "bash", "-c", cmd]
        try:
            subprocess.Popen(args, start_new_session=True)
            status.set_text("Updating in a terminal window... check again afterwards.")
        except OSError:
            status.set_text("Open a terminal (Super+Return) and run: xlin update")

    buttons = Gtk.Box(spacing=8)
    buttons.append(button("Check again", check))
    buttons.append(button("Update XLIN", run_update))
    u.append(row("Software update", None, buttons))
    u.append(row("Status", None, status))
    check()

    r = card()
    box.append(r)
    rstatus = Gtk.Label(label="", xalign=0)
    rstatus.add_css_class("xlin-sub")

    def do_reset():
        rstatus.set_text("Resetting...")
        in_thread(lambda: run(["xlin", "reset"], 90),
                  lambda _r: (rstatus.set_text("Done. Everything is back to the defaults."), win.rebuild("about")))

    def ask_reset():
        try:
            dlg = Gtk.AlertDialog()
            dlg.set_message("Reset XLIN settings?")
            dlg.set_detail("Theme, accent, bars, desktop widgets, fonts and other options go back to the defaults. "
                           "Your wallpaper, pinned apps and files are kept.")
            dlg.set_buttons(["Cancel", "Reset"])
            dlg.set_cancel_button(0)
            dlg.set_default_button(0)
            dlg.choose(win, None, lambda d, res: do_reset_if(d, res))
        except (AttributeError, TypeError):
            do_reset()

    def do_reset_if(d, res):
        try:
            if d.choose_finish(res) == 1:
                do_reset()
        except GLib.Error:
            pass
    r.append(row("Reset XLIN settings", "Back to how a fresh install looks", button("Reset...", ask_reset)))
    r.append(row("Status", None, rstatus))
    return box


# ------------------------------------------------------------------- app
class SettingsWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Settings")
        self.set_default_size(xlin_ui.scaled(920), xlin_ui.scaled(640))
        xlin_ui.titlebar(self, "Settings")
        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.set_child(root)

        self.side = Gtk.ListBox()
        self.side.add_css_class("xlin-side")
        self.side.set_size_request(xlin_ui.scaled(210), -1)
        root.append(self.side)
        root.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))

        self.stack = Gtk.Stack(hexpand=True, vexpand=True)
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        scroll = Gtk.ScrolledWindow(hexpand=True, vexpand=True)
        scroll.set_child(self.stack)
        root.append(scroll)

        self.keep = []  # page objects must stay alive while their widgets are shown

        def keep(obj):
            self.keep.append(obj)
            return obj.box
        builders = {
            "general": lambda: general_page(self),
            "connectivity": lambda: self.connectivity(keep),
            "desktop": lambda: desktop_page(self),
            "bars": lambda: bars_page(self),
            "launcher": lambda: launcher_page(self),
            "personalization": lambda: appearance_page(self),
            "about": lambda: about_page(self),
        }
        self.pages = {}
        for key, label, icon in PAGES:
            r = Gtk.Box(spacing=10)
            r.set_margin_top(4)
            r.set_margin_bottom(4)
            r.set_margin_start(6)
            r.append(Gtk.Image.new_from_icon_name(icon))
            r.append(Gtk.Label(label=label))
            lr = Gtk.ListBoxRow()
            lr.set_child(r)
            lr.key = key
            self.side.append(lr)
            self.pages[key] = (lr, builders[key])
        self.built = set()
        self.side.connect("row-selected", self.on_select)
        self.conn = None
        self.show_page("general")

    def connectivity(self, keep):
        self.conn = ConnectivityPage(self, keep)
        return self.conn.box

    def on_select(self, _lb, lr):
        if lr is None:
            return
        key = lr.key
        if key not in self.built:
            widget = self.pages[key][1]()
            self.stack.add_named(widget, key)
            self.built.add(key)
        self.stack.set_visible_child_name(key)

    def rebuild(self, key):
        """Drop a built page and build it again (after a Reset button, say)."""
        child = self.stack.get_child_by_name(key)
        if child is not None:
            self.stack.remove(child)
        self.built.discard(key)
        self.show_page(key)
        self.on_select(None, self.pages[key][0])
        return False

    def refresh(self):
        """Rebuild the page that is showing (after the window was hidden for a while)."""
        cur = self.stack.get_visible_child_name()
        if cur and cur != "about":
            self.rebuild(cur)

    def show_page(self, key):
        tab = None
        if key in ALIASES:
            key, tab = ALIASES[key]
        if key not in self.pages:
            key = "general"
        self.side.select_row(self.pages[key][0])
        if key == "connectivity":
            self.on_select(None, self.pages[key][0])      # build it now so the tab can be chosen
            if self.conn is not None:
                self.conn.show_tab(tab or "wifi")


class SettingsApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        xlin_ui.live_css()      # restyle at once when the theme or font changes (warm apps too)
        from gi.repository import Gdk
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        try:       # XLIN's window buttons, title and the system font
            with open(os.path.expanduser("~/.config/xlin/tools.css"), "rb") as f:
                theme = Gtk.CssProvider()
                theme.load_from_data(f.read())
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(), theme, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        except Exception:
            pass

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        page = args[0].lower() if args else "general"
        background = "--background" in args
        if background:
            page = "general"
        fresh = self.win is None
        if fresh:
            self.win = SettingsWindow(self)
            xlin_ui.keep_warm(self, self.win)
        elif not self.win.get_visible():
            self.win.refresh()           # it was hidden: show up-to-date values
        if background:
            return 0                     # warm start: built and waiting, nothing on screen
        self.win.show_page(page)
        self.win.present()
        return 0


if __name__ == "__main__":
    sys.exit(SettingsApp().run(sys.argv))
