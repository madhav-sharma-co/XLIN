# Generated by `xlin theme` / `xlin lock` - the XLIN lock screen (hyprlock)
# Your own ~/.config/hypr/hyprlock.conf is not touched; XLIN uses this file.

general {
    hide_cursor = true
    ignore_empty_input = true
    grace = 0
}

animations {
    enabled = true
    bezier = xlin, 0.2, 0.8, 0.2, 1.0
    animation = fadeIn, 1, 4, xlin
    animation = fadeOut, 1, 3, xlin
    animation = inputFieldDots, 1, 2, xlin
}

# Your desktop wallpaper, blurred
background {
    monitor =
    path = @WALLPAPER@
    blur_passes = 4
    blur_size = 8
    noise = 0.012
    contrast = 0.95
    brightness = 0.92
    vibrancy = 0.12
}

# soft veil so text stays readable on any wallpaper
shape {
    monitor =
    size = 100%, 100%
    color = @C_LOCK_TINT@
    rounding = 0
    border_size = 0
    position = 0, 0
    halign = center
    valign = center
}

# time
label {
    monitor =
    text = cmd[update:1000] echo "$(date +'%I:%M')"
    color = @C_LOCK_INK@
    font_size = 112
    font_family = Inter Light
    position = 0, 190
    halign = center
    valign = center
}

# date
label {
    monitor =
    text = cmd[update:60000] echo "$(date +'%A, %B %-d')"
    color = @C_LOCK_MUTED@
    font_size = 20
    font_family = Inter
    position = 0, 105
    halign = center
    valign = center
}

# name
label {
    monitor =
    text = $USER
    color = @C_LOCK_INK@
    font_size = 16
    font_family = Inter Medium
    position = 0, -48
    halign = center
    valign = center
}

# password field (thin, 11px corners like the rest of XLIN)
input-field {
    monitor =
    size = 280, 46
    outline_thickness = 1
    dots_size = 0.22
    dots_spacing = 0.35
    dots_center = true
    rounding = 11
    outer_color = @C_LOCK_RING@
    inner_color = @C_LOCK_FIELD@
    font_color = @C_LOCK_INK@
    font_family = Inter
    fade_on_empty = false
    placeholder_text = <span foreground="##ffffff99">Enter password</span>
    check_color = @C_LOCK_RING@
    fail_color = @C_LOCK_FAIL@
    fail_text = <i>$FAIL</i>
    fail_timeout = 1500
    capslock_color = @C_LOCK_FAIL@
    position = 0, -115
    halign = center
    valign = center
}

# hint
label {
    monitor =
    text = XLIN
    color = @C_LOCK_MUTED@
    font_size = 13
    font_family = Inter Medium
    position = 0, 36
    halign = center
    valign = bottom
}
