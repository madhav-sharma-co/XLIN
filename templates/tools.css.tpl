/* Generated by `xlin theme` - the Tools menu and floating tools, matched to the control panel */
window.xlin-tools {
  background-color: @C_PANEL@;
  color: @C_INK@;
  border: 1px solid @C_LINE_SOLID@;
  border-radius: 11px;
}

.tool-title { font-size: 14px; font-weight: 700; color: @C_INK@; }

/* the x in the corner */
.tool-close {
  min-width: 26px; min-height: 26px; padding: 0;
  border-radius: 8px;
  background-image: none; background-color: transparent;
  color: @C_MUTED@;
  border: none; box-shadow: none;
  font-size: 13px;
}
.tool-close:hover { background-color: @C_HOVER@; color: @C_INK@; }

/* rows in the Tools menu */
.tools-item {
  padding: 9px 10px;
  border-radius: 8px;
  background-image: none; background-color: @C_SOFT@;
  color: @C_INK@;
  border: none; box-shadow: none;
  margin-bottom: 6px;
}
.tools-item:hover { background-color: @C_ACCENT_SOFT@; }
.tools-sub { color: @C_MUTED@; font-size: 11px; }

.calc-expr { color: @C_MUTED@; font-size: 12px; min-height: 16px; }
.calc-display { color: @C_INK@; font-size: 30px; font-weight: 600; }

.calc-key {
  min-height: 44px;
  border-radius: 8px;
  background-image: none;
  background-color: @C_SOFT@;
  color: @C_INK@;
  border: none;
  box-shadow: none;
  font-size: 15px;
  font-weight: 500;
}
.calc-key:hover { background-color: @C_ACCENT_SOFT@; }
.calc-key:active { background-color: @C_ACCENT@; color: @C_ON_ACCENT@; }

.calc-key.calc-op { color: @C_ACCENT@; font-weight: 700; }
.calc-key.calc-eq { background-color: @C_ACCENT@; color: @C_ON_ACCENT@; font-weight: 700; }
.calc-key.calc-eq:hover { opacity: 0.9; }

/* calendar */
.cal-title { font-size: 16px; font-weight: 700; color: @C_INK@; }
.cal-nav {
  padding: 3px 10px; min-height: 0;
  border-radius: 8px;
  background-image: none; background-color: @C_SOFT@;
  color: @C_INK@;
  border: none; box-shadow: none;
}
.cal-nav:hover { background-color: @C_ACCENT_SOFT@; }
.cal-wd { color: @C_MUTED@; font-size: 11px; font-weight: 600; padding: 4px 0; }
.cal-day {
  min-height: 36px; padding: 0;
  border-radius: 8px;
  background-image: none; background-color: transparent;
  color: @C_INK@;
  border: none; box-shadow: none;
  font-size: 13px;
}
.cal-day:hover { background-color: @C_ACCENT_SOFT@; }
.cal-weekend { color: @C_ACCENT@; }
.cal-wd.cal-weekend { color: @C_ACCENT@; }
.cal-out { opacity: 0.35; }
.cal-today { background-color: @C_ACCENT@; color: @C_ON_ACCENT@; font-weight: 700; }
.cal-sel { background-color: @C_ACCENT_SOFT@; font-weight: 700; }
.cal-today.cal-sel { background-color: @C_ACCENT@; }
.cal-info { color: @C_MUTED@; font-size: 12px; margin-top: 4px; }

.power-big { font-size: 30px; font-weight: 700; }
.power-bar block.filled { background-color: @C_ACCENT@; border-radius: 6px; }
.power-bar block.empty { background-color: @C_SOFT@; border-radius: 6px; }
.power-bar trough { min-height: 8px; border-radius: 6px; }
.tools-active { background-color: @C_ACCENT_SOFT@; }
.tools-danger { background-color: @C_LOCK_FAIL@; color: #ffffff; }

/* first-run Welcome */
.welcome-title { font-size: 26px; font-weight: 700; color: @C_INK@; }
.welcome-sub { color: @C_MUTED@; font-size: 13px; }
.welcome-choice {
  padding: 18px 10px; border-radius: 10px;
  background-image: none; background-color: @C_SOFT@; color: @C_INK@;
  border: 1px solid transparent; box-shadow: none;
}
.welcome-choice.active { border-color: @C_ACCENT@; background-color: @C_ACCENT_SOFT@; }
.welcome-keys { font-family: "JetBrainsMono Nerd Font", monospace; font-size: 12px; color: @C_INK@; }
.welcome-primary {
  background-image: none; background-color: @C_ACCENT@; color: @C_ON_ACCENT@;
  border-radius: 8px; padding: 8px 18px; border: none; box-shadow: none;
}
.wall-thumb {
  padding: 3px; border-radius: 12px; min-width: 0; min-height: 0;
  background-image: none; background-color: transparent; border: 2px solid transparent; box-shadow: none;
}
.wall-thumb.active { border-color: @C_ACCENT@; }
.welcome-ok { color: @C_MUTED@; font-size: 12px; }
.welcome-bad { color: @C_LOCK_FAIL@; font-size: 12px; }
.welcome-ghost { background-image: none; background-color: transparent; color: @C_MUTED@; border: none; box-shadow: none; }
.swatch { min-width: 30px; min-height: 30px; padding: 0; border-radius: 15px; background-image: none; box-shadow: none; border: 2px solid transparent; }
.swatch.active { border-color: @C_INK@; }

/* notes */
.xlin-tools searchentry, .xlin-tools entry {
  min-height: 32px; border-radius: 8px; border: none; box-shadow: none;
  background-color: @C_SOFT@; color: @C_INK@;
}
.note-new {
  background-image: none; background-color: @C_SOFT@; color: @C_INK@;
  border: none; box-shadow: none; border-radius: 8px; padding: 4px 12px; min-height: 30px;
}
.note-new:hover { background-color: @C_ACCENT_SOFT@; }
.note-list, .note-list row { background: transparent; }
textview.note-text, textview.note-text text { background-color: transparent; color: @C_INK@; font-size: 14px; }

/* Files */
.fm-list, .fm-side { background: transparent; }
.fm-list row, .fm-side row { border-radius: 8px; padding: 4px 8px; margin-bottom: 1px; color: @C_INK@; }
.fm-list row:hover, .fm-side row:hover { background-color: @C_HOVER@; }
.fm-list row:selected, .fm-side row:selected { background-color: @C_ACCENT_SOFT@; color: @C_INK@; }
.xlin-tools togglebutton.note-new:checked { background-color: @C_ACCENT_SOFT@; color: @C_ACCENT@; }

popover.files-menu > contents { background-color: @C_PANEL@; color: @C_INK@; border: 1px solid @C_LINE_SOLID@; border-radius: 10px; padding: 4px; }
.files-menu-item { background-image: none; background-color: transparent; color: @C_INK@; border: none; box-shadow: none; border-radius: 6px; padding: 6px 14px; }
.files-menu-item:hover { background-color: @C_ACCENT_SOFT@; }
